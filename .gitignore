# AWS credentials — never commit these
.aws/
*.pem
*.env
!network-ids.env

# Terraform (Phase 8+)
.terraform/
*.tfstate
*.tfstate.*
# .terraform.lock.hcl is tracked on purpose — it pins provider versions
tfplan
*.tfplan
# Holds the state bucket name, which embeds the AWS account ID — public repo
terraform/backend.hcl
!terraform/backend.hcl.example

# Downloaded installers — re-fetchable from AWS, not project source
*.pkg

# OS cruft
.DS_Store
